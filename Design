  id        String   @id @default(uuid())
  companyId String
  name      String
  type      String
  createdAt DateTime @default(now())

  company   Company     @relation(fields: [companyId], references: [id])
  locations Location[]
  staff     StaffSite[]
  movements Movement[]

  @@unique([companyId, id])
  @@unique([companyId, name])
  @@index([companyId])
}

model Location {
  id        String   @id @default(uuid())
  companyId String
  siteId    String
  name      String
  createdAt DateTime @default(now())

  site      Site       @relation(fields: [companyId, siteId], references: [companyId, id])
  movements Movement[]

  @@unique([siteId, name])
  @@index([companyId])
}

model Staff {
  id           String      @id @default(uuid())
  companyId    String
  name         String
  email        String
  passwordHash String
  role         StaffRole
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())

  company      Company     @relation(fields: [companyId], references: [id])
  sites        StaffSite[]
  movements    Movement[]

  @@unique([companyId, id])
  @@unique([companyId, email])
  @@index([companyId])
}

model StaffSite {
  companyId String
  staffId   String
  siteId    String

  staff Staff @relation(fields: [companyId, staffId], references: [companyId, id])
  site  Site  @relation(fields: [companyId, siteId], references: [companyId, id])

  @@id([staffId, siteId])
  @@index([companyId])
}

model Item {
  id        String              @id @default(uuid())
  companyId String
  styleCode String
