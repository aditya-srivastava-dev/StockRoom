### 5.2 Prisma Schema (`prisma/schema.prisma`)

```prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  ADMIN
  STORE_MANAGER
  WAREHOUSE_STAFF
  AUDITOR
}

enum StockBucket {
  AVAILABLE
  IN_TRANSIT
  ON_HOLD
  AT_TAILOR
}

enum MovementType {
  OPENING_STOCK
  PO_RECEIPT
  TRANSFER_DISPATCH
  TRANSFER_RECEIVE
  COUNT_ADJUSTMENT
  HOLD_LOCK
  HOLD_RELEASE
  TAILOR_OUT
  TAILOR_IN
}

model Company {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  sites     Site[]
  staff     Staff[]
  items     Item[]
  movements Movement[]
}

